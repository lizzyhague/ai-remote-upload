# Leave empty to derive ~/.local/share/ai-remote/ from the runtime user's HOME.
# AI_REMOTE_UPLOAD_ROOT=/absolute/path/to/ai-remote/uploads
# AI_REMOTE_UPLOAD_SOCKET=/absolute/path/to/ai-remote/upload.sock

# Pause new uploads when free space falls below this value.
# 0 keeps only the free space reported by the operating system.
AI_REMOTE_UPLOAD_MIN_FREE_MIB=1024
